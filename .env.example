# Supabase project (Settings > API in the Supabase dashboard).
# The VITE_-prefixed copies are exposed to the browser at build time; the
# unprefixed copies are read server-side (SSR / server functions).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: only needed if you use the Supabase CLI to link/push migrations.
SUPABASE_PROJECT_ID=

# Server-only. Bypasses Row Level Security — never expose to the client.
# Settings > API > service_role key in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

